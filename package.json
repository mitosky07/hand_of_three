{
  "name": "hand-of-three",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run typecheck:server && npm test && npm run test:e2e",
    "e2e:server": "vite --host 127.0.0.1 --port 4173",
    "test:watch": "vitest",
    "preview": "vite preview",
    "package:itch": "npm run build && python tools/make_zip.py"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/ws": "^8.18.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
